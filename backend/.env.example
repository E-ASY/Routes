# Copia a .env y completa. No commits de secretos reales.
# cp .env.example .env

# Servidor
PORT=5000
NODE_ENV=development
SESSION_SECRET=change-me-long-random-string

# Auth0
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Opcional (SEC-015): secreto OIDC distinto del client secret
# AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:5000
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com
AUTH0_AUDIENCE=
FRONTEND_URL=http://localhost:5173

# Velneo
VELNEO_API_BASE_URL=https://example.invalid/v1/
VELNEO_API_KEY=

# Google Routes
GOOGLE_API_KEY=

# Opcional
# TRUST_PROXY=1
# LOG_LEVEL=info
# DEBUG_ACUFADE_DATA=false
# MAX_WORKERS=20
# MAX_MUNICIPALITIES=50
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAPS_MAX=60
# RATE_LIMIT_ROUTES_MAX=20
